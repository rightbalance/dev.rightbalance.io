[{"_path":"/pages/cto-network","_dir":"pages","_draft":false,"_partial":false,"_locale":"","title":"CTO Network","description":"","tags":["management","cto-network"],"related_content":[],"short_title":"CTO Network","cta_header":"Want to join CTO Network?","cta_button":"Apply","cta_href":"https://airtable.com/appBoDpwJCZHgoCbP/shrLr48SKtBihk3pD","draft":true,"body":{"type":"root","children":[{"type":"element","tag":"h2","props":{"id":"what-it-is"},"children":[{"type":"text","value":"What it is"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"CTO Network is a curated group of technology leaders.\nThe main goal of the group is to help technology leaders succeed in our profession.\nWe're here to share experiences, what's working, what's not, and to continuously evolve our craft."}]},{"type":"element","tag":"h2","props":{"id":"why-another-cto-group"},"children":[{"type":"text","value":"Why another CTO group"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Several CTO groups exist today. However, none of them have all these attributes:"}]},{"type":"element","tag":"h3","props":{"id":"fully-distributed"},"children":[{"type":"text","value":"Fully Distributed"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"While there is value in having a tight local group for a specific city or region, we chose to be fully distributed. Currently, the majority of our members are in the US, UK, Canada, and France. We're not limited to these countries, but advanced English is required."}]},{"type":"element","tag":"h3","props":{"id":"focusing-on-engineering-leadership-craft"},"children":[{"type":"text","value":"Focusing on engineering leadership craft"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"We keep conversations professional, work-related, sharing experiences in a constructive manner."}]},{"type":"element","tag":"h3","props":{"id":"backed-by-a-professional-organization"},"children":[{"type":"text","value":"Backed by a professional organization"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"A lot of groups lose focus, lose organizers, and cease to exist over time. CTO Network is backed by "},{"type":"element","tag":"a","props":{"href":"/"},"children":[{"type":"text","value":"Right Balance"}]},{"type":"text","value":", a professional organization with a mission of evolving humanity through technology."}]},{"type":"element","tag":"h2","props":{"id":"selection-criteria"},"children":[{"type":"text","value":"Selection criteria"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"To keep conversations relevant, we narrow down the applicant profiles to engineering leadership roles only.\nExamples of these roles are:"}]},{"type":"element","tag":"ul","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Chief Technology Officer"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"VP of Engineering"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Director of Engineering"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Engineering Manager"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"or similar (Head of DevOps, Head of QA, Head of Data Science, etc.)"}]}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Here are the examples of the roles that are "},{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"not"}]},{"type":"text","value":" a fit:"}]},{"type":"element","tag":"ul","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Recruiters"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Developers (individual contributors)"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Non-technical roles"}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"etc"}]}]},{"type":"element","tag":"h2","props":{"id":"application-process"},"children":[{"type":"text","value":"Application process"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"To proceed, please fill out a simple qualification form by clicking the button below. In case of approval, we'll add you to our private Slack and our private email list. You'll also start receiving invitations to upcoming events."}]}],"toc":{"title":"","searchDepth":2,"depth":2,"links":[{"id":"what-it-is","depth":2,"text":"What it is"},{"id":"why-another-cto-group","depth":2,"text":"Why another CTO group","children":[{"id":"fully-distributed","depth":3,"text":"Fully Distributed"},{"id":"focusing-on-engineering-leadership-craft","depth":3,"text":"Focusing on engineering leadership craft"},{"id":"backed-by-a-professional-organization","depth":3,"text":"Backed by a professional organization"}]},{"id":"selection-criteria","depth":2,"text":"Selection criteria"},{"id":"application-process","depth":2,"text":"Application process"}]}},"_type":"markdown","_id":"content:pages:cto-network.md","_source":"content","_file":"pages/cto-network.md","_extension":"md"}]